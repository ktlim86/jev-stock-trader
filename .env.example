# Longbridge read-only market data. User Center → application credential.
# https://open.longbridge.com/
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
# English names where the API supports it. Chinese leftovers are translated or dropped.
LONGBRIDGE_LANGUAGE=en
LONGBRIDGE_PRINT_QUOTE_PACKAGES=false

# TypeSafe Jev. Dashboard key. Required for `run`, not for `estimate`.
# https://docs.typesafe.ai/introduction/quickstart
TYPESAFE_API_KEY=

# Google service account. Either a filesystem path or the raw JSON.
# Share the spreadsheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
